msgstr ""
"Project-Id-Version: django-parquet-archive\n"
"Report-Msgid-Bugs-To: \n"
"POT-Creation-Date: 2026-11-11 15:30-0300\n"
"PO-Revision-Date: 2026-11-11 15:30-0300\n"
"Last-Translator: Victor Augusto\n"
"Language-Team: Portuguese (Brazil)\n"
"Language: pt_BR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgid "data source"
msgstr "origem dos dados"

msgid "Archive"
msgstr "Backup frio"

msgid "Database"
msgstr "Banco de dados"

#, python-format
msgid "Filters unavailable in the archive were ignored: %(filters)s."
msgstr "Filtros indisponíveis no backup frio foram ignorados: %(filters)s."

#, python-format
msgid "The archive search does not include the fields: %(fields)s."
msgstr "A busca no backup frio não considera os campos: %(fields)s."

msgid "Showing archived rows (parquet files), read-only."
msgstr "Exibindo registros do backup frio (arquivos parquet), somente para consulta."


msgid ""
"The archive files of this table were not indexed yet, so the listing may be "
"missing some of them. Index them in the archive policies."
msgstr ""
"Os arquivos do backup frio desta tabela ainda não foram indexados, então a "
"listagem pode estar incompleta. Indexe-os nas configurações de backup frio."

#, python-format
msgid ""
"%(count)s archive file of this table was indexed by another field and is "
"not listed. Index it again in the archive policies."
msgid_plural ""
"%(count)s archive files of this table were indexed by another field and are "
"not listed. Index them again in the archive policies."
msgstr[0] ""
"%(count)s arquivo do backup frio desta tabela foi indexado por outro campo e "
"não aparece na listagem. Indexe-o de novo nas configurações de backup frio."
msgstr[1] ""
"%(count)s arquivos do backup frio desta tabela foram indexados por outro "
"campo e não aparecem na listagem. Indexe-os de novo nas configurações de "
"backup frio."

#, python-format
msgid "%(count)s archive file of this table has no %(field)s and is not listed."
msgid_plural ""
"%(count)s archive files of this table have no %(field)s and are not listed."
msgstr[0] ""
"%(count)s arquivo do backup frio desta tabela não tem %(field)s e não "
"aparece na listagem."
msgstr[1] ""
"%(count)s arquivos do backup frio desta tabela não têm %(field)s e não "
"aparecem na listagem."

#, python-brace-format
msgid ""
"The period has more archive files than a page reads: showing the rows since "
"{since}. <a href=\"{url}\">Continue before {since}</a>."
msgstr ""
"O período tem mais arquivos do backup frio do que uma página lê: exibindo os "
"registros a partir de {since}. <a href=\"{url}\">Continuar antes de "
"{since}</a>."

msgid "Invalid or missing date of the row (at)."
msgstr "Data do registro (at) inválida ou ausente."

#, python-format
msgid "Row %(pk)s not found in the archive."
msgstr "Registro %(pk)s não encontrado no backup frio."

#, python-format
msgid "%(name)s from the archive"
msgstr "%(name)s do backup frio"

msgid "Row selection"
msgstr "Seleção dos registros"

msgid "Parquet files"
msgstr "Arquivos parquet"

msgid "Saved configuration"
msgstr "Configuração salva"

msgid "Keep for"
msgstr "Manter por"

msgid "Date fields"
msgstr "Campos de data"

msgid "Configuration"
msgstr "Configuração"

msgid "Archive the selected tables now"
msgstr "Executar backup frio das tabelas selecionadas"

msgid "No active policy selected."
msgstr "Nenhuma configuração ativa selecionada."

#, python-format
msgid "Archiving the tables: %(tables)s"
msgstr "Executando backup frio das tabelas: %(tables)s"

msgid "Index the archive files of the selected tables"
msgstr "Indexar os arquivos do backup frio das tabelas selecionadas"

#, python-format
msgid "Indexing the archive files of the tables: %(tables)s"
msgstr "Indexando os arquivos do backup frio das tabelas: %(tables)s"

msgid "Parquet archive"
msgstr "Backup frio"

msgid "Model"
msgstr "Model"

msgid ""
"The selected rows are written to the archive and DELETED from this table."
msgstr ""
"Os registros selecionados são gravados no backup frio e APAGADOS desta "
"tabela."

msgid "date fields"
msgstr "campos de data"

msgid ""
"A row is archived when any of these fields is older than the configured age."
msgstr ""
"O registro vai para o backup frio quando qualquer um dos campos for mais "
"antigo que o tempo informado."

msgid "Rows older than this are moved to the archive."
msgstr "Registros mais antigos que esse tempo vão para o backup frio."

msgid "Unit"
msgstr "Unidade"

msgid "Rows per file"
msgstr "Registros por arquivo"

msgid ""
"Number of rows per parquet file. Ideally each file ends up close to 512MB."
msgstr ""
"Quantidade de registros por arquivo parquet. O ideal é cada arquivo ficar "
"perto de 512MB."

msgid "Ordering"
msgstr "Ordenação"

msgid ""
"Order of the rows in the parquet files, and the field is always saved. With "
"a date field of the model that is not null (e.g. the creation date), the "
"admin reads only the files of each page."
msgstr ""
"Ordem dos registros nos arquivos parquet, e o campo é sempre salvo. Com um "
"campo de data do próprio model que não aceita nulo (ex.: a data de criação), "
"o admin lê só os arquivos de cada página."

msgid "Saved columns"
msgstr "Campos salvos"

msgid "columns"
msgstr "campos"

msgid "The primary key is always saved."
msgstr "A chave primária é sempre salva."

msgid "Choose the model to list its fields."
msgstr "Escolha o model para listar os campos."

#, python-format
msgid ""
"Not supported in the archive (encrypted fields, custom value objects...): "
"%(fields)s."
msgstr ""
"Sem suporte no backup frio (campos criptografados, objetos de valor...): "
"%(fields)s."

#, python-format
msgid "%(field)s (ascending)"
msgstr "%(field)s (crescente)"

#, python-format
msgid "%(field)s (descending)"
msgstr "%(field)s (decrescente)"

msgid "Model not found in the project."
msgstr "Model não encontrado no projeto."

#, python-format
msgid ""
"Rows are deleted after archiving and %(model)s has relations that prevent "
"it: %(relations)s."
msgstr ""
"Os registros são apagados após o backup frio e %(model)s possui relações "
"que impedem isso: %(relations)s."

#, python-format
msgid "The primary key (%(field)s) has no type supported by the archive."
msgstr "A chave primária (%(field)s) não tem tipo suportado no backup frio."

msgid "Days"
msgstr "Dias"

msgid "Months"
msgstr "Meses"

msgid "Years"
msgstr "Anos"

msgid "created at"
msgstr "criado em"

msgid "updated at"
msgstr "alterado em"

msgid "model"
msgstr "model"

msgid "Model whose old rows are moved to the archive."
msgstr "Model cujos registros antigos são transferidos para o backup frio."

msgid "active"
msgstr "ativo"

msgid "Only active policies are run by the archive task."
msgstr "Somente configurações ativas são executadas pela task de backup frio."

msgid "configuration"
msgstr "configuração"

msgid ""
"Dict consumed by the archive task: rows_per_file, filter, ordering and "
"schema."
msgstr ""
"Dict consumido pela task de backup frio: rows_per_file, filter, ordering e "
"schema."

msgid "archive policy"
msgstr "configuração de backup frio"

msgid "archive policies"
msgstr "configurações de backup frio"

msgid "files indexed at"
msgstr "arquivos indexados em"

msgid ""
"Last run of the indexing of the archive files, which the admin needs to list "
"all of them."
msgstr ""
"Última indexação dos arquivos do backup frio, que o admin precisa para "
"listar todos eles."

msgid "path"
msgstr "caminho"

msgid "Path inside the model folder."
msgstr "Caminho dentro da pasta do model."

msgid "rows"
msgstr "registros"

msgid "index field"
msgstr "campo indexado"

msgid ""
"Field of the first and last dates, empty when the policy has no index field."
msgstr ""
"Campo da primeira e da última data, vazio quando a configuração não tem "
"campo indexado."

msgid "first date"
msgstr "primeira data"

msgid "last date"
msgstr "última data"

msgid "archive file"
msgstr "arquivo do backup frio"

msgid "archive files"
msgstr "arquivos do backup frio"

#, python-format
msgid "%(model)s (relation %(field)s)"
msgstr "%(model)s (relação %(field)s)"

msgid "Home"
msgstr "Início"

msgid "archive"
msgstr "backup frio"

msgid ""
"Row read from the archive (parquet file). It no longer exists in the "
"database and cannot be changed."
msgstr ""
"Registro lido do backup frio (arquivo parquet). Ele não existe mais no "
"banco e não pode ser alterado."

msgid "Back"
msgstr "Voltar"
